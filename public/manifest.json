{
  "name": "github hyper",
  "description": "Plugins to enhance the github user experience",
  "version": "0.6.4",
  "manifest_version": 3,
  "author": "ch1lam",
  "icons": {
    "128": "./icons/icon128.png"
  },
  "action": {
    "default_icon": "./icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["contentScript.css"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
